[Desktop Entry]
Type=Application
Name=RT82 Screen
Name[ru]=Экран RT82
Comment=Keeps the Epomaker RT82 clock in sync and shows widgets
Comment[ru]=Синхронизирует время на Epomaker RT82 и показывает виджеты
Exec=rt82-screen --tray
Icon=rt82-plasma
Terminal=false
NoDisplay=true
X-KDE-autostart-phase=2
X-GNOME-Autostart-enabled=true
