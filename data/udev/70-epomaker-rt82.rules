# Epomaker RT82: access to the keyboard's vendor interfaces for the user at
# the machine (logind "uaccess"), without root and without the "input" group.
#
#  * 36b0:30a3 interface 1 (usage page 0xFF60): settings and screen commands.
#    Needed by rt82ctl / RT82 Screen and by Epomaker Hub in Chromium (WebHID):
#    without it Chromium lists the keyboard but cannot open it.
#  * 1919:1919 interface 1 (usage page 0x00FF): the screen controller, which
#    appears behind the keyboard's internal hub only on request.
#
# The ordinary keyboard interfaces stay root-only, so programs cannot read
# what you type.
#
# udev requires all ATTRS{} of one rule to match on the same parent device,
# and the ids and the interface number live on different parents, so the
# device is tagged first and the interface is checked in a second rule.
# The file must sort before 73-seat-late.rules, which applies "uaccess".

ACTION=="remove", GOTO="rt82_end"
SUBSYSTEM!="hidraw", GOTO="rt82_end"

ATTRS{idVendor}=="36b0", ATTRS{idProduct}=="30a3", ENV{RT82_PART}="keyboard"
ATTRS{idVendor}=="1919", ATTRS{idProduct}=="1919", ENV{RT82_PART}="screen"
ENV{RT82_PART}=="?*", ATTRS{bInterfaceNumber}=="01", TAG+="uaccess"

LABEL="rt82_end"
